<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>app</groupId>
    <artifactId>ide-unillanos</artifactId>
    <version>1.0.0</version>
    <name>IDE Unillanos</name>
    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>app.Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
                <executions>
                    <execution>
                        <id>plugin-highlight</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>plugin-highlight</classifier>
                            <includes>
                                <include>app/plugins/highlight/**</include>
                            </includes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>plugin-search</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>plugin-search</classifier>
                            <includes>
                                <include>app/plugins/search/**</include>
                            </includes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>plugin-wordcount</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>plugin-wordcount</classifier>
                            <includes>
                                <include>app/plugins/wordcount/**</include>
                            </includes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>plugin-wordlist</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>plugin-wordlist</classifier>
                            <includes>
                                <include>app/plugins/wordlist/**</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
